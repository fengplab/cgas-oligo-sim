// cGAS-oligo simulation pipeline - portable configuration.
//
// This file is TRACKED and holds nothing machine-specific. Every value that
// differs between installations is declared null here and supplied by a local
// site file that is NOT tracked:
//
//     nextflow run main.nf -profile slurm -c config/site.config -resume
//
// Nextflow auto-loads ./nextflow.config but does NOT look in config/, so the
// -c is required. Forgetting it is not silent: main.nf calls requireParam on
// every path it needs, so the run stops with a message naming the missing
// parameter rather than publishing into ./results.
//
// Because no site value is set here, config merge precedence does not matter -
// there is nothing for the site file to have to override.
//
// Start from conf/site.config.example.

nextflow.enable.dsl = 2

manifest {
    name            = 'cgas-oligo-sim'
    description     = 'cGAS occupancy site calling, pose clustering and visualisation'
    nextflowVersion = '!>=25.10.2'
    version         = '0.1.0'
}

params {
    // ---- Site-specific: set these in config/site.config, never here ----
    // Launch directory must be on BeeGFS (Nextflow needs file locking).
    // The publish directory is NFS so reports open from the laptop.
    project_dir       = null
    outdir            = null
    genesis_cg_tool   = null   // genesis_cg_tool checkout (GENESIS >1.7:
                               // src/analysis/cg_tools)
    container_python  = null   // image with python3, numpy, pandas, matplotlib.
                               // Pin to an exact tag or digest, never :latest.
    container_genesis = null   // image with atdyn, julia and genesis_cg_tool
    js_bundle         = null   // path to 3Dmol.js, when vendor_js = true

    // Set automatically, not user-facing: stamps the profiling filenames below
    // so repeated runs accumulate rather than overwrite each other.
    profiling_stamp   = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // ---- Local (non-container) toolchain ----
    // Per tool, supply EITHER the local path below OR the container above. A
    // process uses its local install when the path is set, and falls back to
    // container_genesis when it is null, so the two can be mixed during a
    // migration and nothing has to change when containers come back.
    // Verified in Nextflow 25.10.2: a process whose container directive
    // resolves to null runs natively even while singularity.enabled is true.
    genesis_bin       = null   // GENESIS install bin/ (atdyn, cg_convert, ...)
    julia_exe         = null   // julia binary that runs the genesis_cg_tool scripts
    julia_depot       = null   // JULIA_DEPOT_PATH. KEEP THE TRAILING COLON:
                               // without it only this depot is used and Julia's
                               // bundled resources are not loaded.
    julia_project     = null   // JULIA_PROJECT; defaults to genesis_cg_tool

    // ---- Sequence inputs ----
    fasta           = null   // oligos, variable length, mutants as separate entries
    metadata        = null   // TSV: sequence_id, lineage_id, role [, chrom, start, end, strand, mutation, notes]
    min_length      = 60     // >45 bp is where human cGAS responds; below that a null is uninformative
    max_length      = 1000
    require_coords  = false  // set true when a genome-anchored step runs

    // ---- Motifs ----
    motifs_meme     = null   // MEME or minimal-MEME PWMs
    motifs_iupac    = null   // TSV: motif_id, consensus (IUPAC)
    motif_pseudocount = 0.25

    // ---- PWMcos (sequence-specific recognition as a FORCE-FIELD term) ----
    // OFF by default, deliberately. A PFM fed to PWMcos imposes the motif, so a
    // PWMcos-on run cannot test whether cGAS prefers that motif - it tests what
    // the motif would predict. Keep the two arms separate and never pool them.
    pwmcos          = false
    pwmcos_scale    = 3.9    // tutorial value; re-derive for cGAS before production
    pwmcos_shift    = -0.4   // tutorial value; re-derive for cGAS before production

    // ---- GENESIS CG ----
    cg_replicates   = 100    // independent free-association runs per sequence
    cg_nsteps       = 3000000
    cg_timestep     = 0.010
    cg_temperature  = 300
    cg_gamma_t      = 0.01
    cg_ionic_strength = 0.15
    // Cutoffs from the published TBP-DNA tutorial control file.
    cg_cutoffdist_ele      = 52.0
    cg_cutoffdist_DNAbp    = 18.0
    cg_pairlistdist_ele    = 57.0
    cg_pairlistdist_PWMcos = 23.0
    cg_pairlistdist_DNAbp  = 23.0
    cg_pairlistdist_exv    = 15.0
    cg_pro_DNA_ele_scale_Q = -1.0
    // UNVERIFIED and a real scientific decision. The tutorial uses NOBC (no
    // boundary), which is fine when the protein starts bound. For FREE
    // ASSOCIATION from random starts, NOBC lets cGAS diffuse away and never
    // return, and a box instead sets an effective concentration - which matters
    // here, because cGAS activity is concentration-dependent through
    // condensation. Confirm the GENESIS CG keyword and decide box vs restraint
    // before any production free-association run.
    // PBC gives a defined concentration; NOBC does not, and with free
    // association cGAS can diffuse away and never return.
    cg_boundary     = 'PBC'
    // Angstrom, cubic box edge. Written to box_size_x/y/z in [BOUNDARY], which
    // atdyn reads only when type = PBC (verified in the GENESIS 2.2.0 source).
    // The box IS the concentration: one cGAS and one oligo in a 300 A cube is
    // ~61 uM. Above physiological, which is the usual trade in association
    // simulations - a physiological box would be mostly diffusion. Record it.
    cg_box_size     = 300
    cg_free_association = true  // Mode B. Warns if combined with NOBC.
    cg_crdout_period = 10000
    // Node shape: override in the site file if your partition differs.
    // MPI is retired. atdyn is built with --disable-mpi and runs as a single
    // serial process with OpenMP threads; the workload is many independent
    // trajectories, so parallelism comes from Slurm fan-out, not from ranks.
    cg_omp_threads  = 2

    // ---- Inputs (no defaults: must be supplied) ----
    occupancy       = null   // long-format TSV: sequence_id, replicate, position, dwell_frac
    null_occupancy  = null   // long-format TSV: sequence_id, shuffle_id, replicate, position, dwell_frac
    poses           = null   // samplesheet TSV: sequence_id, site_id, npz_path
    contacts        = null   // long-format TSV: sequence_id, site_id, residue, position, contact_frac
    sequences       = null   // FASTA of candidate oligos
    panel           = null   // TSV of fixed mutation positions, per sequence_id
    structures      = null   // samplesheet TSV; see conf/structures.template.tsv

    // ---- Simulation-tier inputs ----
    // Samplesheets, not globs: identity comes from a declared column so it can
    // never depend on file order. Generate these by running the upstream
    // scripts in bin/ by hand; those steps are deliberately not in the workflow.
    oligos          = null   // TSV: sequence_id, lineage_id, fasta  (one record per file)
    prepared_structures = null // TSV: structure_id, pdb  (output of prepare_structures.py)
    motif_pfms      = null   // TSV: family, pfm. Omit for a no-motif run, which
                             // skips the PWMcos arms entirely.

    // ---- Arm matrix ----
    partners        = ''     // comma-separated partner names; empty means no partner arm
    multibasin      = true   // add a multi-basin arm when >= 2 structures are given
    null_shuffles   = 20     // shuffles per sequence in the null panel
    null_replicates = 12     // replicates per shuffle

    // ---- Submission throughput ----
    // The campaign is tens of thousands of independent trajectories, so
    // throughput is set by how many Slurm accepts in flight, not by anything
    // inside a task. Nextflow's default queueSize for grid executors is 100,
    // which would leave the cluster idle here.
    //
    // queue_size must stay BELOW the account's MaxSubmitJobs, or submissions
    // start failing once the queue fills. Check it before raising this:
    //     scontrol show config | grep -i maxsubmit
    //     sacctmgr show assoc where user=$USER format=user,maxsubmit
    queue_size        = 500
    submit_rate_limit = '50/1min'   // protects slurmctld from a submit storm

    // ---- Site calling ----
    null_percentile = 90     // percentile of the matched shuffle null used as the occupancy threshold
    dwell_min       = 0.05   // within one replicate, minimum fraction of post-equilibration
                             // frames with cGAS resident at a position for that replicate
                             // to count as occupying it
    bootstrap_n     = 2000   // bootstrap resamples for the occupancy confidence interval
    seed            = 20261120

    // ---- Occupancy extraction ----
    contact_cutoff  = 12.0   // Angstrom. UNVERIFIED: calibrate against the contact-distance
                             // distribution of a bound reference before production.
    footprint_min   = 12     // contiguous nucleotides contacted before it counts as binding
    equil_frac      = 0.2    // leading fraction of each trajectory discarded
    min_frames_occ  = 50     // fail a replicate with fewer analysed frames

    // ---- Representative-pose rendering ----
    // OPTIONAL and intentionally unset. When null, no replicate gate is applied:
    // every site clearing the null threshold is rendered, and each site's
    // replicate_frac is reported so a value can be chosen from real data later.
    replicate_min   = null

    // ---- Pose clustering (gromos / Daura algorithm) ----
    // No default: a clustering cutoff below the data's own noise floor silently
    // produces one cluster per frame, and above it absorbs all variation. Run
    // cluster_poses.py --report-only first and choose from the RMSD sweep.
    rmsd_cutoff     = null   // Angstrom, interface beads. Scientific choice - MUST be set
    // ---- Pose extraction ----
    // Both are scientific choices, so they are parameters rather than defaults
    // buried in a script. pose_beads = 'protein' puts every cGAS bead in the
    // ensemble, so orientation counts and no extra threshold is needed;
    // 'interface' keeps only cGAS beads contacting the site in a majority of
    // its bound frames, ignoring distal motion. The site's DNA beads are always
    // included, because cluster_poses.py superposes over the whole file and
    // protein-only alignment would erase the binding mode it is meant to
    // cluster - which also means rmsd_cutoff is on a DNA+protein scale.
    pose_beads        = 'protein'
    pose_site_overlap = 0.5  // fraction of a site's positions a frame's footprint
                             // must cover to join that site's ensemble

    min_frames      = 50     // fail a site with fewer pooled frames than this
    min_top_pop_frac = 0.05  // fail a site whose largest cluster is smaller than this

    // ---- Visualisation ----
    vendor_js       = false  // false: 3Dmol.js from CDN (smaller file, needs network to view)
                             // true:  inline the library (self-contained, needs js_bundle)
}

// Publish to NFS by copy: never symlink or hardlink, since links into BeeGFS
// are broken when read from the laptop. The 'results' fallback only applies
// when params.outdir is unset, which main.nf refuses to run with anyway.
process {
    publishDir = [
        path: { params.outdir ? "${params.outdir}/${task.process.tokenize(':').last().toLowerCase()}" : 'results' },
        mode: 'copy',
        overwrite: true
    ]
}

profiles {

    slurm {
        executor {
            queueSize       = params.queue_size
            submitRateLimit = params.submit_rate_limit
        }
        process {
            executor       = 'slurm'
            queue          = 'defq'
            cpus           = 1
            memory         = '4 GB'
            clusterOptions = { "--ntasks=1 --cpus-per-task=${task.cpus}" }
            beforeScript   = 'module load singularity'

            // Analysis processes: CPU, modest memory.
            withLabel: 'analysis' {
                cpus   = 4
                memory = '16 GB'
            }

            // Pairwise-RMSD clustering is the memory-hungry step: an N x N matrix
            // over pooled frames. Measured: 4,000 frames takes ~52 s and a
            // 0.12 GB matrix; 20,000 frames needs ~3 GB and 50,000 ~19 GB.
            // Sized for a few thousand frames - raise memory for more.
            withLabel: 'cluster' {
                cpus   = 8
                memory = '32 GB'
            }

            // Rendering and figure generation: single-threaded, small.
            withLabel: 'render' {
                cpus   = 2
                memory = '8 GB'
            }

            // GENESIS atdyn is serial + OpenMP: one task, cpus-per-task
            // threads. This label still replaces clusterOptions, so it must
            // restate every required flag.
            withLabel: 'genesis' {
                cpus           = 2        // must equal params.cg_omp_threads
                memory         = '8 GB'
                clusterOptions = { "--ntasks=1 --cpus-per-task=${task.cpus}" }
            }

            // GPU label for the simulation tiers (not used by the visualisation
            // branch). A process setting its own clusterOptions REPLACES the
            // profile value, so --ntasks and --cpus-per-task are repeated here.
            // UNVERIFIED: the GRES string. Confirm the cluster's gres name and
            // whether a type qualifier is required (e.g. gpu:a100:1) before use.
            withLabel: 'gpu' {
                queue          = 'gpu'
                cpus           = 8
                memory         = '64 GB'
                clusterOptions = { "--ntasks=1 --cpus-per-task=${task.cpus} --gres=gpu:1" }
            }
        }

        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = "${launchDir}/.singularity/images"
        }
    }

    // Local profile exists only so that -stub-run can be exercised without a
    // scheduler. It is not the laptop branch and runs no real workload.
    stub_local {
        process.executor = 'local'
        singularity.enabled = false
    }
}

// ---- Execution profiling ----
// Always on, following the pattern in fengplab/chipseq: timestamped trace,
// report and timeline under <outdir>/pipeline_info/, so a re-run never
// overwrites the record it is meant to be compared against.
//
// chipseq declares its timestamp as `def trace_timestamp = ...` at config top
// level. Nextflow 25.10.2 rejects that ("Variable declarations cannot be mixed
// with config statements"), so the stamp lives in params instead - which also
// means all three files share one evaluation and cannot straddle a second
// boundary, and the value lands in the params record for provenance.
//
// The trace is the machine-readable artefact; the report and timeline HTML are
// the human view. So the trace uses raw = true: peak_rss in bytes, durations in
// ms, %cpu as a bare number. Verified on 25.10.2 that %cpu and peak_rss are in
// the default field set, and that `cpus` and `memory` record what was
// REQUESTED - which is what makes a requested-vs-used comparison possible.
//
// Turn a finished run into resource recommendations with:
//   python3 bin/summarize_resources.py --trace <outdir>/pipeline_info/execution_trace_*.txt

trace {
    enabled   = true
    overwrite = false
    file      = "${params.outdir ?: 'results'}/pipeline_info/execution_trace_${params.profiling_stamp}.txt"
    raw       = true
    fields    = 'task_id,hash,process,tag,status,exit,attempt,cpus,memory,' +
                'duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

report {
    enabled   = true
    overwrite = false
    file      = "${params.outdir ?: 'results'}/pipeline_info/execution_report_${params.profiling_stamp}.html"
}

timeline {
    enabled   = true
    overwrite = false
    file      = "${params.outdir ?: 'results'}/pipeline_info/execution_timeline_${params.profiling_stamp}.html"
}

// No time directives anywhere, by project policy.
