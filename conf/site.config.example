// Site-specific configuration. COPY, do not edit in place:
//
//     mkdir -p config && cp conf/site.config.example config/site.config
//     # edit config/site.config with this machine's paths
//     nextflow run main.nf -profile slurm -c config/site.config -resume
//
// config/ is gitignored, so this file is never touched by a pull and never
// committed back. nextflow.config holds everything portable and sets every
// value below to null, so there is nothing here that has to win a merge.
//
// Omit a value and the run stops with requireParam naming it, rather than
// starting and publishing somewhere unintended.

params {
    // Nextflow is launched from here. MUST be on BeeGFS: NFS has no file
    // locking, and .nextflow/ and work/ are written through locks.
    project_dir       = '/home/bradlem9/bradlem9/cgas-oligo-sim'

    // Published outputs. On NFS so the laptop can open reports. Published
    // with mode 'copy' - links into BeeGFS are broken when read from there.
    outdir            = '/home/bradlem9/isilon/cGAS/cgas-oligo-sim'

    // genesis_cg_tool checkout (ships with GENESIS >1.7 under
    // src/analysis/cg_tools).
    genesis_cg_tool   = null

    // Container images you have pulled and verified. Pin to an exact tag or
    // digest, never :latest. Leave a container null and supply the matching
    // local path below instead; set per tool, whichever you have.
    container_python  = null   // python3 + numpy, pandas, matplotlib
    container_genesis = null   // atdyn + julia + genesis_cg_tool

    // ---- Local toolchain, used only where the container above is null ----
    // Each is checked at task start, so a wrong path fails the first task
    // rather than 34,000 of them.

    // GENESIS install bin/, holding atdyn and the analysis tools. Built with
    // --disable-mpi, so atdyn is serial + OpenMP.
    genesis_bin       = '/home/bradlem9/bradlem9/cgas-oligo-sim/opt/genesis-2.2.0-archv3/bin'

    // Julia that runs the genesis_cg_tool scripts. Called explicitly rather
    // than through the scripts' shebang, so julia need not be on PATH.
    julia_exe         = '/home/bradlem9/bradlem9/cgas-oligo-sim/opt/julia-1.10.14/bin/julia'

    // Package depot. MUST be on BeeGFS - it is written under locks. KEEP THE
    // TRAILING COLON: without it Julia loads only this depot and not its own
    // bundled resources.
    julia_depot       = '/home/bradlem9/bradlem9/cgas-oligo-sim/.julia:'

    // Pinned Julia environment holding ArgParse, i.e. the directory with the
    // Project.toml and Manifest.toml. Defaults to genesis_cg_tool if unset.
    julia_project     = null

    // Only needed when vendor_js = true.
    js_bundle         = null

    // Uncomment if this partition's node shape differs from the default.
    // atdyn is serial, so this is the OpenMP thread count only.
    // cg_omp_threads = 2
}
